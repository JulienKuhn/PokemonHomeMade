  m_Script: {fileID: 11500000, guid: e72eaf98b31a99c44adf10dabbbaefd8, type: 3}
  m_Name: TestDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  isTalkingHead: 0
  Lines:
  - SpeakerName: 'Regis '
    Line: "H\xE9 ! tu m'\xE9coute ?"
  - SpeakerName: 'Regis '
    Line: Tu avais l'air ailleurs le temps d'un instant.
  - SpeakerName: 'Regis '
    Line: "\xE7a t'arrive souvent ces derniers temps je trouve"
  - SpeakerName: 'Regis '
    Line: Ok alors, comme je te disais
  - SpeakerName: 'Regis '
    Line: "Mon grand p\xE8re est parti en ville quelques temps. Et j'ai un peu fouill\xE9
      son laboratoire"
  - SpeakerName: 'Regis '
    Line: "Je suis tomb\xE9 sur 3 pokeballs ! \xE7a te dirais que l'on en prenne
      un chacun pour un combat amical ? "
  - SpeakerName: 'Regis '
    Line: "C'est d\xE9cid\xE9 ! Le dernier au laboratoire de mon grand p\xE8re est
      un Ombraf\xE9lin chauve ! "
